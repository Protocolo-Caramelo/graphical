{
    "version": 3,
    "configurePresets":
    [
        {
            "name": "devquote",
            "binaryDir": "${sourceDir}/__build_devquote__",
            "cacheVariables": {
                "compilation_mode": "DEVQUOTE",
                "GRAPHICAL_BUILD_TESTS": "ON"
            }
        },

        {
            "name": "windows_devquote",
            "binaryDir": "${sourceDir}/__build_windows_devquote__",
            "cacheVariables": {
                "compilation_mode": "TOOLCHAIN_WINDOWS_DEVQUOTE",
                "GRAPHICAL_BUILD_TESTS": "ON"
            }
        }

    ]
}
